<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.PokemonPokedex" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/poke_red</item>
        <item name="colorPrimaryVariant">@color/poke_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Custom attributes -->
        <item name="cardBackgroundColor">#F5F5F5</item>
    </style>

    <!-- Custom style for RecyclerView items -->
    <style name="PokedexCardView">
        <item name="android:background">?attr/cardBackgroundColor</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
